# Created by setup.cmd on each machine; bound to the folder path.
/app/python/
/app/venv/
/app/models/
__pycache__/
# Where versions before 2026-11-12 put them; setup.cmd moves them into app\.
/python/
/venv/
/models/

# The terms dictionary holds company and colleague names: it stays local.
/terms.txt
*.local.txt

# Left by an interrupted transcription.
*.partial

# Local settings: where the AI was found, the window's last language and microphone.
*.local.ini
